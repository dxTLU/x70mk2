{
  "runtime": {
    "framerate": 0,
    "interpolation": true,
    "turbo": false,
    "highQualityPen": true,
    "warpTimer": false,
    "maxClones": "Infinity",
    "fencing": false,
    "miscLimits": false,
    "stageWidth": 480,
    "stageHeight": 360,
    "maxTextureDimension": 8192
  },
  "bridge": {
    "host": "127.0.0.1",
    "port": 7070,
    "allowedOrigins": [
      "file://",
      "null",
      "tw-editor://.",
      "https://turbowarp.org",
      "http://localhost:8601"
    ],
    "allowedHostSuffixes": [],
    "fsRoots": {
      "data": "data/files",
      "assets": "assets"
    },
    "maxFileBytes": 268435456,
    "exec": {
      "timeoutMs": 30000,
      "maxOutputBytes": 4194304,
      "commands": {
        "node-version": {
          "cmd": "node",
          "args": [
            "--version"
          ]
        },
        "git-status": {
          "cmd": "git",
          "args": [
            "status",
            "--short"
          ]
        },
        "echo": {
          "cmd": "node",
          "args": [
            "-e",
            "console.log(process.argv.slice(1).join(' '))",
            "--"
          ],
          "extraArgs": true
        }
      }
    }
  },
  "redis": {
    "url": "redis://127.0.0.1:6379/0",
    "keyPrefix": "x70:",
    "required": false
  },
  "sqlite": {
    "path": "data/x70.sqlite"
  },
  "build": {
    "projectsDir": "projects",
    "outDir": "dist",
    "targets": [
      "html",
      "electron-linux64",
      "electron-win64"
    ],
    "extract": true,
    "appVersion": "1.0.0",
    "windowMode": "window",
    "gpu": {
      "forceHighPerformance": true,
      "ignoreBlocklist": true,
      "uncappedFps": false
    },
    "stampProjects": true,
    "watchDebounceMs": 750
  }
}