{
  "name": "x70mk2-proxy",
  "version": "1.0.0",
  "description": "Self-hosted rewriting web proxy with a Varnish (VCL) front end",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --max-http-header-size=65536 scripts/serve-all.js",
    "start:proxy": "node --max-http-header-size=65536 server.js",
    "start:varnish": "bash scripts/start.sh",
    "start:node": "bash scripts/start-node-only.sh",
    "stop": "bash scripts/stop.sh",
    "test": "node --test test/*.test.js",
    "test:varnish": "node --test test/varnish.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e"
  }
}
