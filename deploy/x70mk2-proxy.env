# Settings for the x70mk2-proxy systemd service (installed as /etc/default/x70mk2-proxy).
# Every variable is optional; README.md describes them all. Restart after editing:
#   sudo systemctl restart x70mk2-proxy

# Keep the proxy private: browsers ask for this user name and password.
#BASIC_AUTH=user:change-me

# Serve the app directly on all interfaces (only when Varnish is not in front of it).
#HOST=0.0.0.0
#PORT=8080

# Search engine for words typed into the address box (%s is the query).
#SEARCH_URL=https://duckduckgo.com/?q=%s

# Send all outbound traffic through another HTTP proxy.
#UPSTREAM_PROXY=http://user:pass@proxy.internal:3128
#NO_PROXY=intranet.example

# Allow proxying to private networks and localhost (lab use only: it allows SSRF).
#ALLOW_PRIVATE=0

# HTTPS for the app itself (node-only setups; Varnish cannot terminate TLS). The service runs as
# a throwaway user, so hand it the files as credentials (sudo systemctl edit x70mk2-proxy):
#   [Service]
#   LoadCredential=tls.crt:/etc/ssl/certs/proxy.pem
#   LoadCredential=tls.key:/etc/ssl/private/proxy.key
#TLS_CERT=/run/credentials/x70mk2-proxy.service/tls.crt
#TLS_KEY=/run/credentials/x70mk2-proxy.service/tls.key

#TOOLBAR=1
#LOG_REQUESTS=0
#SESSION_TTL_HOURS=168

# Plugins (plugins/README.md). State and plugin storage live next to DATA_FILE.
#PLUGINS_ENABLED=1
#PLUGINS_DIR=/opt/x70mk2/plugins
#PLUGINS=dark-mode,request-log
#PLUGIN_ADMIN=1
#PLUGIN_HOOK_TIMEOUT=3000
